# Cloudflare credentials — used by scaffold.sh and CI
# Get these from https://dash.cloudflare.com/profile/api-tokens
# Create a custom token with these permission rows ("+ Add more"):
#   Row 1 (required): Resources: Account -> your account
#                      Permission: Workers Core > Workers Scripts -> Edit
#   Row 2 (only if setting CF_CUSTOM_DOMAIN below):
#                      Resources: Zone -> your domain (or All zones)
#                      Permission: DNS & Zones > Zone -> Edit
#   Row 3 (only if setting CF_CUSTOM_DOMAIN below):
#                      Resources: Zone -> your domain (or All zones)
#                      Permission: DNS & Zones > DNS -> Edit
#   Row 4 (only if setting CF_CUSTOM_DOMAIN below):
#                      Resources: Zone -> your domain (or All zones)
#                      Permission: Workers Routes -> Edit
CF_ACCOUNT_ID=your_account_id_here
CF_API_TOKEN=your_api_token_here

# Worker name — the identifier you actually deploy to and access the site
# through, not just a label. It becomes part of the URL:
#   production (no custom domain): https://<name>.<account-subdomain>.workers.dev
#   PR previews:                   https://<name>-pr-<N>.<account-subdomain>.workers.dev
# This is the only place it's set — scripts/deploy.sh passes it to
# `wrangler deploy --name`, so wrangler.toml never needs it.
CF_WORKER_NAME=astro-cf-pages

# Optional: custom domain (e.g. myapp.com).
# This is the only place it's set — scripts/deploy.sh passes it to
# `wrangler deploy --domains`, which provisions the DNS record and cert
# automatically. Nothing to edit in wrangler.toml.
CF_CUSTOM_DOMAIN=
